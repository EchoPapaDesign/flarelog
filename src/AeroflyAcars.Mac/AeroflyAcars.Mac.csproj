<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Flarelog für macOS: eigenes Programmfenster (Photino → WebKit von macOS), Dock-Symbol wie jede Mac-App.
    Wird mit build-mac.sh zu Flarelog.app verpackt (auf einem Mac oder in GitHub Actions).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AeroflyAcars.Mac</RootNamespace>
    <AssemblyName>Flarelog</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fenster mit der eingebauten WebKit-Ansicht; bringt Photino.Native für Intel und Apple Silicon mit. -->
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AeroflyAcars.Core\AeroflyAcars.Core.csproj" />
    <ProjectReference Include="..\AeroflyAcars.Runtime\AeroflyAcars.Runtime.csproj" />
  </ItemGroup>

</Project>
