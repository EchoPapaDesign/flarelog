<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programmlogik, die Konsole und Desktop-Programm gemeinsam nutzen: Empfang, Auswertung, Display-Server. -->
  <PropertyGroup>
    <RootNamespace>AeroflyAcars.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows-Datenschutz-API (DPAPI): API-Schlüssel verschlüsselt speichern -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kabinenansagen (Flarelog-Soundpack von AeRodri, siehe sounds/CREDITS.md) – Dateinamen nicht ändern. -->
    <EmbeddedResource Include="..\..\sounds\*.wav" LogicalName="Flarelog.Sounds.%(Filename)%(Extension)" WithCulture="false" />
    <!-- „Was ist neu?“ im Programm. WithCulture=false: sonst hält der Build „.en.md“ für eine Sprachdatei
         und packt sie in eine eigene Satelliten-DLL, wo Flarelog sie nicht findet. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Flarelog.Changelog.de.md" WithCulture="false" />
    <EmbeddedResource Include="..\..\CHANGELOG.en.md" LogicalName="Flarelog.Changelog.en.md" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AeroflyAcars.Core\AeroflyAcars.Core.csproj" />
  </ItemGroup>

</Project>
